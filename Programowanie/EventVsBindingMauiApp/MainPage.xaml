<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="EventVsBindingMauiApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <StackLayout>
        <Slider x:Name="rotationSlider"
                Maximum="360"
                MaximumTrackColor="Bisque"
                Minimum="0"
                MinimumTrackColor="AliceBlue"
                ValueChanged="Slider_ValueChanged"
                Value="150" />
        <Label x:Name="rotationLabel"
               Margin="40"
               HorizontalOptions="Center"
               Rotation="90"
               Text="To jest label" />

        <Label Margin="40"
               HorizontalOptions="Center"
               Rotation="{Binding Source={x:Reference rotationSlider}, Path=Value}"
               Text="{Binding Source={x:Reference rotationSlider}, Path=Value}" />
    </StackLayout>

</ContentPage>
